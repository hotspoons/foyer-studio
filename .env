# Foyer Studio — project-level environment defaults.
#
# Loaded by:
#   * scripts/dev/ardour.sh + scripts/bootstrap-workspace.sh
#     (sourced before reading vars; existing process-env wins)
#   * .github/workflows/{ci,release}.yml ("Load .env" step writes
#     these into $GITHUB_ENV so cache keys / matrix expressions see
#     the same values CI uses locally)
#
# Per-developer overrides live in `.env.local` (gitignored). Shell
# env always wins, so `ARDOUR_TAG=master just run` is also fine.

# Ardour git ref the shim is built against. Tags are major.minor
# only (`9.5`, not `9.5.0`). Branch (`master`) and commit SHA also
# accepted. ABI compatibility with the user's installed Ardour
# matters for shipped artifacts, so production tracks release tags;
# bump to `master` only while developing against post-tag APIs.
ARDOUR_TAG=9.5

# Dev-only apt fast-path: when this is set AND equals `ARDOUR_TAG`,
# `just ardour ensure` apt-installs Ardour from Debian sid instead of
# running the ~25-min `waf build` — handy for dev devs already on a
# sid stack. The source tree is still cloned + `waf configure`-d
# (~30 s) for the shim headers under `<ardour>/build/libs/`. The
# production Dockerfile no longer uses this path; it source-builds
# Ardour 9.5 directly so the image carries its own libs (sid still
# carries 9.2 as of writing).
#
# Default: empty → `just ardour ensure` always source-builds, matching
# the container. Override per-dev in `.env.local`, e.g. when sid catches
# up to 9.5: `DEBIAN_SID_ARDOUR_VER=9.5`.
DEBIAN_SID_ARDOUR_VER=

# Autovocoder git ref the dev-time `just autovocoder ensure` (and
# `just prep`) builds against. Accepts a tag, branch, or commit SHA.
# On every ensure, an existing `ext/autovocoder` checkout is **fetched**
# from origin and updated to this ref's tip (so `main` tracks latest).
# When empty, each ensure follows `refs/remotes/origin/HEAD` (upstream
# default branch).
# Unlike ARDOUR_TAG there's no ABI-stability concern (autovocoder is
# an LV2 bundle, not linked into the foyer binary); pin a SHA only for
# reproducible snapshots.
AUTOVOCODER_REF=main
