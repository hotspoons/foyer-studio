# Foyer Studio — project-level environment defaults.
#
# Loaded by:
#   * scripts/dev/ardour.sh + scripts/bootstrap-workspace.sh
#     (sourced before reading vars; existing process-env wins)
#   * .github/workflows/{ci,release}.yml ("Load .env" step writes
#     these into $GITHUB_ENV so cache keys / matrix expressions see
#     the same values CI uses locally)
#
# Per-developer overrides live in `.env.local` (gitignored). Shell
# env always wins, so `ARDOUR_TAG=master just run` is also fine.

# Ardour git ref the shim is built against. Tags are major.minor
# only (`9.2`, not `9.2.0`). Branch (`master`) and commit SHA also
# accepted. ABI compatibility with the user's installed Ardour
# matters for shipped artifacts, so production tracks release tags;
# bump to `master` only while developing against post-tag APIs.
ARDOUR_TAG=9.2

# Ardour version available as a pre-built binary in Debian sid. When
# `ARDOUR_TAG` matches this, `just ardour ensure` apt-installs the
# Debian package instead of running `waf build` — same trick the
# production Dockerfile uses, saves ~25 min on a cold dev container.
# The source tree is still cloned and `waf configure` is still run
# (~30 s) because the shim's CMakeLists includes generated headers
# under `<ardour>/build/libs/`. Only the slow `waf build` step is
# skipped. Set empty (`DEBIAN_SID_ARDOUR_VER=`) or to a different
# value to force the from-source path.
DEBIAN_SID_ARDOUR_VER=9.2

# Autovocoder git ref the dev-time `just autovocoder ensure` (and
# `just prep`) builds against. Accepts a tag, branch, or commit SHA —
# resolution mirrors ARDOUR_TAG (try `git clone --branch`, fall back
# to fetch-by-SHA on failure). When empty, `git clone` takes the
# upstream default branch and stays on whatever HEAD points to.
# Unlike ARDOUR_TAG there's no ABI-stability concern (autovocoder is
# an LV2 bundle, not linked into the foyer binary), but pinning to a
# known-good SHA helps reproduce a dev container in the same state
# the next person spun up.
AUTOVOCODER_REF=
